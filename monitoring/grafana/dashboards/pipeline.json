{
  "id": null,
  "uid": "pipeline",
  "title": "Pipeline",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events processed",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "events_processed_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Anomalies",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "anomalies_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events / s",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "events_per_second", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processing latency",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(processing_latency_seconds_sum[1m])", "refId": "A" }]
    }
  ]
}
